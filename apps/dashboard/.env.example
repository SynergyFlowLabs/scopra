# Auth.js. Create a GitHub OAuth App whose callback is:
# http://localhost:3000/api/auth/callback/github locally, or
# https://<dashboard-host>/api/auth/callback/github in production.
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=configure-out-of-band-never-commit

# HTTPS origin for Scopra Caloris; only server-side routes may use it.
SCOPRA_CONTROL_PLANE_URL=https://api.example.invalid

# Ed25519 PKCS#8 private key matching Caloris' SCOPRA_DASHBOARD_JWT_PUBLIC_KEY.
# Keep this only in Vercel/server environments; never expose it to the browser.
SCOPRA_API_JWT_PRIVATE_KEY=configure-out-of-band-never-commit
