# Copy to deploy/control-plane/.env.production and chmod 0600 before use.
# Use a managed PostgreSQL database with TLS and certificate verification.
SCOPRA_DATABASE_URL=postgresql://scopra:REPLACE_ME@postgres.example.net:5432/scopra

# Set this to the public API hostname whose A/AAAA records point to the Docker host.
SCOPRA_API_DOMAIN=api.example.com

# Paste the PUBLIC PEM generated by scripts/generate-dashboard-keypair.sh.
# Keep the literal \n sequences in a single-line value; Caloris expands them.
SCOPRA_DASHBOARD_JWT_PUBLIC_KEY=REPLACE_WITH_ED25519_PUBLIC_PEM_ESCAPED_AS_ONE_LINE
