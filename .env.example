# Local development only. Never use these dev values in a public deployment.
SCOPRA_ENV=development
SCOPRA_API_HOST=0.0.0.0
SCOPRA_API_PORT=8080
SCOPRA_DATABASE_URL=postgres://scopra:scopra@localhost:5432/scopra?sslmode=disable

# Generate an Ed25519 dashboard-to-Caloris assertion keypair out of band.
# Keep the private key only in the dashboard server's environment; Caloris
# receives the corresponding public key. Never paste either value into chat.
SCOPRA_DASHBOARD_JWT_PUBLIC_KEY=
SCOPRA_API_JWT_PRIVATE_KEY=

# Dashboard's server-side Caloris origin. Browser code must use same-origin routes.
SCOPRA_CONTROL_PLANE_URL=http://127.0.0.1:8080

# Local `scopra init` origins. The Go CLI reads these from its process
# environment (or pass --api-url/--dashboard-url); it does not read .env files.
SCOPRA_API_URL=http://127.0.0.1:8080
SCOPRA_DASHBOARD_URL=http://127.0.0.1:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
